[sub_resource type="GDScript" id="GDScript_cnhyw"]
script/source = "extends AnimatedSprite2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	frame = randi_range(0, sprite_frames.get_frame_count(\"PlantAnimation\") - 1)
	play(\"PlantAnimation\")


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_gmiel"]
script/source = "extends AnimatedSprite2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	frame = randi_range(0, sprite_frames.get_frame_count(\"FlowerAnimation\") - 1)
	play(\"FlowerAnimation\")


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

